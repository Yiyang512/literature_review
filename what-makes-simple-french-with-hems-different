<script>
(() => {
  const root = document.getElementById("hems-market-review");
  if (!root || !("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  const selectors = [
    ".key-points", ".section > .section-kicker", ".section > h2", ".section > h3",
    ".section > p", ".finding", ".mechanism", ".source-figure", ".figure",
    ".table-wrap", ".callout", ".limitations", ".implications", ".method-box"
  ].join(",");
  const items = [...root.querySelectorAll(selectors)];
  root.classList.add("sfh-motion-ready");

  items.forEach((item, index) => {
    item.classList.add("sfh-reveal");
    item.style.setProperty("--sfh-delay", String(Math.min(index % 4, 3) * 70) + "ms");
    if (item.matches(".source-figure, .figure")) item.classList.add(index % 2 ? "sfh-reveal--left" : "sfh-reveal--right");
    if (item.matches(".finding, .mechanism, .callout, .method-box")) item.classList.add("sfh-reveal--scale");
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add("is-visible");
      observer.unobserve(entry.target);
    });
  }, { threshold:0.1, rootMargin:"0px 0px -8% 0px" });

  items.forEach((item) => observer.observe(item));
})();
</script>
